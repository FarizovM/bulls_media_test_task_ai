{
  "name": "@bulls-media/agent-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "migrate": "prisma migrate deploy",
    "seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "test": "tsx --test test/guardrails.spec.ts test/retry.spec.ts test/ticket-tool.spec.ts test/agent.e2e-spec.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.5.0",
    "jose": "^6.2.17",
    "openai": "^6.0.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
