PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
USER_RATE_LIMIT_MAX=30
USER_RATE_LIMIT_WINDOW_MS=60000

# Local development only. Production must set this to false and configure OIDC.
AUTH_BYPASS_DEV=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid agent:read agent:triage
# false allows local demo builds; production Compose passes true itself.
VITE_REQUIRE_OIDC=false
OIDC_ORIGIN=

# Optional locally; required in production. Apply backend/migrations before startup.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=7000
POSTGRES_PASSWORD=change-this-local-password

# true — локальне демо без запитів до OpenAI.
MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
